# Application
APP_ENV=development
LOG_LEVEL=INFO

# Report Repository
REPORTS_PATH=./sample_reports

# Data Database
DATA_DB_HOST=localhost
DATA_DB_PORT=5432
DATA_DB_NAME=analytics
DATA_DB_USER=reporter
DATA_DB_PASSWORD=secret

# Metadata Database
META_DB_HOST=localhost
META_DB_PORT=5432
META_DB_NAME=reports_meta
META_DB_USER=reporter
META_DB_PASSWORD=secret

# Storage (for generated PDFs)
# Uses Reflex's uploaded_files directory by default for automatic web serving
# PDFs are accessible via /_upload/<filename> URL
STORAGE_BACKEND=filesystem
STORAGE_PATH=uploaded_files

# S3 Storage (optional - for PDF storage)
# S3_BUCKET=my-reports-bucket
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# S3 Image Storage (optional - for images referenced in reports)
# S3_IMAGES_BUCKET=my-images-bucket
# S3_IMAGES_ENDPOINT=https://storage.yandexcloud.net
# S3_IMAGES_ACCESS_KEY=your-images-access-key
# S3_IMAGES_SECRET_KEY=your-images-secret-key
# S3_IMAGES_REGION=ru-central1
# PRESIGNED_URL_EXPIRATION=3600

# Task Queue
TASK_QUEUE_BACKEND=background_tasks

# Defaults
DEFAULT_QUERY_TIMEOUT=300
MAX_PDF_SIZE_MB=50
CACHE_TTL_MINUTES=5

# Authentication
AUTH_API_BASE_URL=https://your-api-url.com
# JWT_PUBLIC_KEY is optional. If not provided, JWT signature verification will be disabled (WARNING: not secure for production)
# Line endings are mandatory if the key is provided! Use \n if needed
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----
