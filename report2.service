[Unit]
Description=Report2 PDF Report Generator Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/report2
Environment=HOME=/var/www
Environment="PATH=/opt/report2/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/report2/.env
ExecStart=/opt/report2/.venv/bin/reflex run --env prod --backend-only
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=report2

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/opt/report2 /var/www/.local /var/www/.cache /var/www/.config

# Resource limits
LimitNOFILE=65536
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
